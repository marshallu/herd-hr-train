{% extends 'base.twig' %}

{% block content %}
{% include 'partials/no-hero.twig' %}

<div class="muhr-archive">
	<div class="muhr-archive__columns">
		<div class="muhr-archive__main">
			<header class="page-header">
				<h1 class="entry-title muhr-archive__title">{{ archive_title }}</h1>
			</header>

			{% if sessions %}
				{% for session in sessions %}
					<div id="course{{ session.id }}" class="muhr-session">
						<div class="muhr-session__content">
							<div class="muhr-session__date">
								<div class="muhr-session__month">{{ session.start_month }}</div>
								<div class="muhr-session__day">{{ session.start_day }}</div>
							</div>
							<div class="muhr-session__body">
								<div>
									{% if session.seats_left > 0 %}
										<a href="{{ session.registration_url }}" class="muhr-session__title">{{ session.title }}</a>
									{% else %}
										<span class="muhr-session__title">{{ session.title }}</span>
									{% endif %}

									{% if session.style == 'virtual' %}
										<div class="muhr-session__meta"><span class="muhr-session__label">Location:</span> <a href="{{ session.training_url }}">Training Link</a></div>
									{% elseif session.style == 'hybrid' %}
										<div class="muhr-session__meta"><span class="muhr-session__label">Location:</span> {{ session.location }} and <a href="{{ session.training_url }}">{{ session.training_url }}</a></div>
									{% else %}
										<div class="muhr-session__meta"><span class="muhr-session__label">Location:</span> {{ session.location }}</div>
									{% endif %}

									<div class="muhr-session__meta">
										{{ session.start_formatted }} - {{ session.end_formatted }} &middot;
										<span class="muhr-session__seats">{{ session.seats_left }}</span> spots remaining
									</div>
									<span class="muhr-session__seats-taken">Seats taken: {{ session.seats_taken }}</span>

									<div class="muhr-session__meta">
										<span class="muhr-session__label">Instructor:</span> {{ session.instructor_name }}
										(<a href="{{ session.instructor_url }}">Instructor Access</a>)
									</div>

									<div class="muhr-session__description">
										{% if session.course_description %}
											{{ session.course_description|raw }}
										{% else %}
											{{ session.term_description|raw }}
										{% endif %}
									</div>
								</div>

								<div class="muhr-session__actions">
									{% if session.seats_left > 0 %}
										<a href="{{ session.registration_url }}" class="button button--primary">Register</a>
									{% else %}
										<div class="btn muhr-session__full">Course Full</div>
									{% endif %}
								</div>
							</div>
						</div>
					</div>
				{% endfor %}

				{{ pagination|raw }}
			{% endif %}
		</div>

		<div class="muhr-archive__sidebar">
			{{ sidebar|raw }}
		</div>
	</div>
</div>
{% endblock %}
